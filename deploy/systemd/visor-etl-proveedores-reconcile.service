[Unit]
Description=Visor - refresco fin de semana del ETL de proveedores (ultimos 7 dias)
Documentation=file:///home/prodapp/visor-productividad/scripts/etl/proveedores/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=prodapp
Group=prodapp
WorkingDirectory=/home/prodapp/visor-productividad
# --days 7 recarga [ayer-6..ayer]. Como el ETL reemplaza por (empresa, fecha), re-correr
# no duplica: sirve para recuperar dias que quedaron vacios porque el POS llego tarde.
ExecStart=/usr/bin/python3 /home/prodapp/visor-productividad/scripts/etl/proveedores/etl_proveedores.py --days 7
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
