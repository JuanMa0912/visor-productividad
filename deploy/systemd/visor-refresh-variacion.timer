[Unit]
Description=Visor - timer diario de refresh de margen_item_dia_roll (informe variacion)
Documentation=man:systemd.timer(5)

[Timer]
# Todos los dias a las 08:15 (hora del sistema). Despues del sync ETL ~07:50
# (visor-etl-sync.timer). Persistent=true cubre si la VM arranca tarde.
# Este job reconstruye el roll completo y warm de payload_std (cortes + mtd-N).
OnCalendar=*-*-* 08:15:00
# Si la VM estaba apagada en ese momento, ejecutar al arrancar
Persistent=true
# Dispersa la ejecucion para evitar picos
RandomizedDelaySec=180
Unit=visor-refresh-variacion.service

[Install]
WantedBy=timers.target
