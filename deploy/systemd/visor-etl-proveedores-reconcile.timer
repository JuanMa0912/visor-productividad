[Unit]
Description=Visor - timer fin de semana del refresco de proveedores (sab y dom 07:12, 7 dias)
Documentation=man:systemd.timer(5)

[Timer]
# Sabados y domingos 07:12, en el mismo hueco que el diario de lunes a viernes
# (despues de ventas-item 07:09, antes del sync a GCP 07:35).
# Cobertura completa: el sabado recarga [sab-7..vie] y el domingo [dom-7..sab], asi que
# los dias de fin de semana quedan cubiertos sin necesidad del diario.
OnCalendar=Sat,Sun *-*-* 07:12:00
# Si la VM estaba apagada, ejecutar al arrancar.
Persistent=true
Unit=visor-etl-proveedores-reconcile.service

[Install]
WantedBy=timers.target
