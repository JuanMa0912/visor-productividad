[Unit]
Description=Visor - ETL diario ventas x item POS(217) -> produXdia.ventas_item_diario (232)
Documentation=file:///home/prodapp/visor-productividad/scripts/etl/ventas-item/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=prodapp
Group=prodapp
WorkingDirectory=/home/prodapp/visor-productividad
# python3 del sistema (tiene psycopg2-binary). No hay venv. Sin flags = ayer.
ExecStart=/usr/bin/python3 /home/prodapp/visor-productividad/scripts/etl/ventas-item/etl_ventas_item.py
StandardOutput=journal
StandardError=journal
# OJO: NO se declara SuccessExitStatus=3 a proposito.
# Exit 3 = alguna empresa/dia cargo 0 filas (el POS no habia cerrado el dia).
# Eso NO es exito: dejandolo fuera, systemd marca la unidad como failed y el
# problema se ve en `systemctl --failed` en vez de pasar callado, que es
# justo lo que dejo ventas_item_diario atrasada sin que nadie se enterara.
# Endurecimientos. NO usar ProtectHome: el deploy y el .env.etl viven en /home/prodapp.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
